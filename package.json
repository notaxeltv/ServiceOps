{
  "name": "serviceops",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "db:generate": "pnpm --filter @serviceops/api exec prisma generate",
    "db:migrate": "pnpm --filter @serviceops/api exec prisma migrate dev",
    "db:push": "pnpm --filter @serviceops/api exec prisma db push"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@9.15.4"
}
